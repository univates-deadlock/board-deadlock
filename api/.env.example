# The API container receives this file through docker-compose.yml: api.env_file.
# Keep the existing authentication secret when migrating from the root .env.
# Generate a new secret only for a brand-new environment (minimum 32 characters).
BETTER_AUTH_SECRET=

# For running the API directly OUTSIDE Docker Compose, also provide:
# PORT=4000
# DATABASE_URL=postgresql://techpro:YOUR_PASSWORD@localhost:5432/techpro
# BETTER_AUTH_URL=http://localhost:4000
# FE_BASE_URL=http://localhost:3000
# Docker Compose already sets PORT, DATABASE_URL, BETTER_AUTH_URL and FE_BASE_URL.
