generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum ClientType {
  INDIVIDUAL
  COMPANY

  @@map("CLIENT_TYPE")
}

enum UserRole {
  ADMIN
  PLANNING
  TECHNICIAN

  @@map("USER_ROLE")
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED

  @@map("QUOTE_STATUS")
}

enum QuoteItemType {
  PRODUCT
  SERVICE
  OTHER

  @@map("QUOTE_ITEM_TYPE")
}

enum ServiceOrigin {
  QUOTE
  SUPPORT
  MAINTENANCE
  REVISION
  WARRANTY
  OTHER

  @@map("SERVICE_ORIGIN")
}

enum WarrantyType {
  SERVICE
  MANUFACTURER

  @@map("WARRANTY_TYPE")
}

enum RevisionStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED

  @@map("REVISION_STATUS")
}

// ======================================================
// BETTER AUTH
// ======================================================

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  role          UserRole @default(TECHNICIAN)
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  isActive      Boolean  @default(true)  @map("is_active")

  createdQuotes    Quote[]           @relation("QuoteCreatedBy")
  createdServices  Service[]         @relation("ServiceCreatedBy")
  technicianVisits VisitTechnician[]
  sessions         Session[]
  accounts         Account[]

  @@map("user")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Account {
  id                    String    @id
  user                  User      @relation(fields: [userId], references: [id])
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(3)

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

// ======================================================
// ENTITIES
// ======================================================

model Client {
  id        String     @id @default(uuid()) @db.Uuid
  type      ClientType
  name      String     @db.VarChar(200)
  document  String?    @db.VarChar(20)
  notes     String?    @db.Text
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamp(3)

  contactName String? @map("contact_name") @db.VarChar(200)
  phone       String? @db.VarChar(20)
  whatsapp    String  @db.VarChar(20)
  location    String  @db.VarChar(100)
  email       String? @unique @db.VarChar(100)

  quotes   Quote[]   @relation("ClientQuote")
  services Service[]

  @@map("client")
}

model Quote {
  id       String      @id @default(uuid()) @db.Uuid
  clientId String      @map("client_id") @db.Uuid
  status   QuoteStatus @default(DRAFT)

  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  notes     String? @db.Text
  createdBy String  @map("created_by")

  sentAt              DateTime? @map("sent_at") @db.Timestamp(3)
  decidedAt           DateTime? @map("decided_at") @db.Timestamp(3)
  decisionNotes       String?   @map("decision_notes") @db.Text
  decisionEvidenceUrl String?   @map("decision_evidence_url") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  client  Client @relation("ClientQuote", fields: [clientId], references: [id])
  creator User   @relation("QuoteCreatedBy", fields: [createdBy], references: [id])

  items   QuoteItem[]
  service Service?

  @@index([clientId])
  @@index([createdBy])
  @@index([status])
  @@map("quote")
}

model QuoteItem {
  id      String        @id @default(uuid()) @db.Uuid
  quoteId String        @map("quote_id") @db.Uuid
  type    QuoteItemType

  description String  @db.Text
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_item")
}

model Service {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @map("client_id") @db.Uuid

  quoteId String? @unique @map("quote_id") @db.Uuid

  origin ServiceOrigin

  status String @db.VarChar(100)

  title       String  @db.VarChar(200)
  description String? @db.Text

  externalOsNumber String? @map("external_os_number") @db.VarChar(100)

  plannedStart DateTime? @map("planned_start") @db.Timestamp(3)
  plannedEnd   DateTime? @map("planned_end") @db.Timestamp(3)
  completedAt  DateTime? @map("completed_at") @db.Timestamp(3)

  createdBy String @map("created_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  client  Client @relation(fields: [clientId], references: [id])
  quote   Quote? @relation(fields: [quoteId], references: [id])
  creator User   @relation("ServiceCreatedBy", fields: [createdBy], references: [id])

  visits     ServiceVisit[]
  warranties Warranty[]
  revisions  Revision[]

  @@index([clientId])
  @@index([createdBy])
  @@index([status])
  @@index([plannedStart])
  @@map("service")
}

model ServiceVisit {
  id        String @id @default(uuid()) @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  scheduledStart DateTime  @map("scheduled_start") @db.Timestamp(3)
  scheduledEnd   DateTime? @map("scheduled_end") @db.Timestamp(3)

  actualStart DateTime? @map("actual_start") @db.Timestamp(3)
  actualEnd   DateTime? @map("actual_end") @db.Timestamp(3)

  // Os requisitos não enumeram os valores válidos
  // para o status de uma visita.
  status String @db.VarChar(100)

  description String? @db.Text
  notes       String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  technicians VisitTechnician[]
  revisions   Revision[]

  @@index([serviceId])
  @@index([scheduledStart])
  @@index([status])
  @@map("service_visit")
}

model VisitTechnician {
  visitId      String @map("visit_id") @db.Uuid
  technicianId String @map("technician_id")

  visit ServiceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  technician User @relation(fields: [technicianId], references: [id])

  @@id([visitId, technicianId])
  @@index([technicianId])
  @@map("visit_technician")
}

model Warranty {
  id        String       @id @default(uuid()) @db.Uuid
  serviceId String       @map("service_id") @db.Uuid
  type      WarrantyType

  description String? @db.Text

  manufacturer     String? @db.VarChar(150)
  productReference String? @map("product_reference") @db.VarChar(200)

  startsAt DateTime @map("starts_at") @db.Date
  endsAt   DateTime @map("ends_at") @db.Date

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([endsAt])
  @@index([type])
  @@map("warranty")
}

model Revision {
  id        String @id @default(uuid()) @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  visitId String? @map("visit_id") @db.Uuid

  scheduledAt DateTime       @map("scheduled_at") @db.Timestamp(3)
  status      RevisionStatus @default(PENDING)

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  visit ServiceVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([serviceId])
  @@index([visitId])
  @@index([scheduledAt])
  @@index([status])
  @@map("revision")
}
