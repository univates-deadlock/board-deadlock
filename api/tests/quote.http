# Manual examples. Sign in first as ADMIN or PLANNING and copy only the
# better-auth.session_token name/value from Set-Cookie into the variable below.
# Replace clientId with a UUID returned by POST /api/clients.
# Replace quoteId / itemId with UUIDs returned by the requests below.
@baseUrl = http://localhost:4000
@cookie = better-auth.session_token=replace-with-session-token
@clientId = replace-with-client-uuid
@quoteId = replace-with-quote-uuid
@itemId = replace-with-item-uuid


### Sign in
POST {{baseUrl}}/api/auth/sign-in/email
Content-Type: application/json
Origin: http://localhost:3000

{
  "email": "admin@example.com",
  "password": "replace-with-local-password"
}

### Create quote (with items)
# Values ​​in R$. Item subtotal = quantity * unitPrice - discount.
POST {{baseUrl}}/api/quotes
Content-Type: application/json
Cookie: {{cookie}}

{
  "clientId": "{{clientId}}",
  "notes": "Orçamento de exemplo",
  "discount": 50,
  "items": [
    {
      "type": "PRODUCT",
      "description": "Câmera IP 2MP",
      "quantity": 4,
      "unitPrice": 250.5,
      "discount": 20
    },
    {
      "type": "SERVICE",
      "description": "Instalação",
      "quantity": 1,
      "unitPrice": 400
    }
  ]
}

### Create quote (empty draft)
POST {{baseUrl}}/api/quotes
Content-Type: application/json
Cookie: {{cookie}}

{
  "clientId": "{{clientId}}"
}

### List quotes
GET {{baseUrl}}/api/quotes
Cookie: {{cookie}}

### List quotes (filters)
GET {{baseUrl}}/api/quotes?clientId={{clientId}}&status=DRAFT
Cookie: {{cookie}}

### Get quote (with items)
GET {{baseUrl}}/api/quotes/{{quoteId}}
Cookie: {{cookie}}

### Update quote (notes / general discount)
PATCH {{baseUrl}}/api/quotes/{{quoteId}}
Content-Type: application/json
Cookie: {{cookie}}

{
  "notes": "Observação atualizada",
  "discount": 30
}

### Add item
POST {{baseUrl}}/api/quotes/{{quoteId}}/items
Content-Type: application/json
Cookie: {{cookie}}

{
  "type": "OTHER",
  "description": "Cabo e conectores",
  "quantity": 10.5,
  "unitPrice": 3.9
}

### Update item
PATCH {{baseUrl}}/api/quotes/{{quoteId}}/items/{{itemId}}
Content-Type: application/json
Cookie: {{cookie}}

{
  "quantity": 6,
  "discount": 10
}

### Delete item
DELETE {{baseUrl}}/api/quotes/{{quoteId}}/items/{{itemId}}
Cookie: {{cookie}}

### Delete quote (only DRAFT)
DELETE {{baseUrl}}/api/quotes/{{quoteId}}
Cookie: {{cookie}}

### --- Casos de erro esperados ---

### Item with discount greater than quantity * unitPrice (422)
POST {{baseUrl}}/api/quotes/{{quoteId}}/items
Content-Type: application/json
Cookie: {{cookie}}

{
  "type": "PRODUCT",
  "description": "Desconto inválido",
  "quantity": 1,
  "unitPrice": 10,
  "discount": 99
}

### Quantity zero (400, validation)
POST {{baseUrl}}/api/quotes/{{quoteId}}/items
Content-Type: application/json
Cookie: {{cookie}}

{
  "type": "PRODUCT",
  "description": "Quantidade inválida",
  "quantity": 0,
  "unitPrice": 10
}
